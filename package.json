{
  "name": "github-repo-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --test tests/*.test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm scan:secrets && pnpm build"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
